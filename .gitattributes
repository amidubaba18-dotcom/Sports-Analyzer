* text=auto

# Keep the container entrypoint and Dockerfile LF-only even on Windows.
*.sh text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.html text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf

# Binary artifacts
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
