# Local development only. Copy to .env; never commit .env or a real token.
#   Copy-Item .env.example .env
#
# Football fixtures are free to fetch. Register at
# https://www.football-data.org/client/register, then paste the token here.
FOOTBALL_DATA_TOKEN=

# Production settings are supplied by the host (Render/Fly secrets), not by a
# committed file. These are shown only as a reference for a container run:
#
# APP_ENV=production
# ADMIN_TOKEN=<long random value; required when APP_ENV=production>
# SPORTS_ANALYZER_DB=/data/sports_analyzer.db
# SPORTS_ANALYZER_SCHEDULER=1
# ALLOWED_ORIGINS=
